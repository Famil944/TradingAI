TELEGRAM_BOT_TOKEN=
OTCHARTS_API_KEY=
OTC_ADMIN_CHAT_ID=
TRADING_AI_DB_PATH=data/bot.db
OTC_MAX_INSTRUMENTS=5
OTC_COOLDOWN_SECONDS=120
LOG_LEVEL=INFO

OTC_TEST_MODE=true
OTC_POLL_SECONDS=300
OTC_POLL_REQUEST_BUDGET=12

OTC_HEALTH_REPORT_SECONDS=120

OTC_SIGNAL_MODE=conditional

# Groq is recovery-only: it must never publish trading signals.
GROQ_API_KEY=
OTC_GROQ_ENABLED=false
OTC_GROQ_RECOVERY_ENABLED=true
GROQ_MODEL=openai/gpt-oss-20b
# Legacy signal limits are ignored by recovery.
GROQ_INTERVAL_SECONDS=300
GROQ_MAX_REQUESTS=100
GROQ_MAX_TOKENS=150000
# Recovery has its own budget, so an old local GROQ_MAX_REQUESTS=100 does not cap it.
GROQ_RECOVERY_INTERVAL_SECONDS=60
GROQ_RECOVERY_MAX_REQUESTS=1000
GROQ_RECOVERY_MAX_TOKENS=150000
OTC_PRIMARY_MODE=ready
