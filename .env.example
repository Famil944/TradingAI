TELEGRAM_BOT_TOKEN=
OTCHARTS_API_KEY=
OTC_ADMIN_CHAT_ID=
TRADING_AI_DB_PATH=data/bot.db
OTC_MAX_INSTRUMENTS=5
OTC_COOLDOWN_SECONDS=120
LOG_LEVEL=INFO

OTC_TEST_MODE=true
OTC_POLL_SECONDS=300
# Read-only Mini App needs a real HTTPS tunnel or reverse proxy; localhost only.
OTC_MINI_APP_ENABLED=false
OTC_MINI_APP_PORT=8091
OTC_MINI_APP_URL=

OTC_CATALOGUE_REFRESH_SECONDS=50
OTC_READY_MIN_CONFIRMATIONS=3
# Strict M1-only regime: already closed M5 trend and fresh price-move veto.
# Enabled by default; set false only for a matched research comparison.
OTC_M1_STRICT_ENABLED=true

# Resource-heavy offline ML collection is opt-in for Android/Termux.
OTC_ML_TRAINING=false
OTC_ML_COLLECT_SECONDS=300
OTC_POLL_REQUEST_BUDGET=12

OTC_HEALTH_REPORT_SECONDS=120

OTC_SIGNAL_MODE=conditional

# Groq API key (optional; reserved for shadow analysis)
GROQ_API_KEY=

GROQ_MODEL=openai/gpt-oss-20b
GROQ_INTERVAL_SECONDS=300
GROQ_MAX_REQUESTS=100
GROQ_MAX_TOKENS=150000
OTC_PRIMARY_MODE=ready
